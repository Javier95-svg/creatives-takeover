  "funnels": [
    {
      "key": "output_led_activation",
      "name": "Output-led visitor to active user",
      "windowDays": 14,
      "steps": [
        "landing_viewed",
        "hero_input_submitted",
        "first_output_generated",
        "signup_prompt_shown",
        "signup_completed",
        "artifact_claim_succeeded"
      ],
      "breakdownProperty": "route"
    },
    {
      "key": "acquisition_to_activation",
      "name": "Acquisition to activation",
      "windowDays": 14,
      "steps": [
        "landing_viewed",
        "signup_started",
        "signup_completed",
        "dashboard_viewed",
        "activation_first_output_generated",
        "activation_completed"
      ]
    },
    {
      "key": "onboarding_completion",
      "name": "Onboarding completion",
      "windowDays": 7,
      "steps": ["signup_completed", "onboarding_started", "onboarding_completed"]
    },
    {
      "key": "core_tool_value",
      "name": "Core tool time-to-value",
      "windowDays": 7,
      "steps": ["tool_opened", "tool_output_created"],
      "breakdownProperty": "tool"
    },
    {
      "key": "monetization",
      "name": "Pricing to paid",
      "windowDays": 30,
      "steps": [
        "pricing_viewed",
        "upgrade_clicked",
        "checkout_session_created",
        "subscription_started"
      ],
      "breakdowns": ["checkout_session_expired", "payment_failed"]
    },
    {
      "key": "pmf_feedback_loop",
