# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Analytics Configuration
VITE_AMPLITUDE_API_KEY=your-amplitude-browser-api-key
VITE_POSTHOG_API_KEY=your-posthog-project-api-key
VITE_POSTHOG_API_HOST=https://us.i.posthog.com

# Supabase Edge Function secrets for backend analytics events
# Configure these in Supabase Dashboard > Edge Functions > Secrets
AMPLITUDE_API_KEY=your-amplitude-server-api-key
POSTHOG_PROJECT_API_KEY=your-posthog-project-api-key
POSTHOG_HOST=https://us.i.posthog.com

# PMF Customer Discovery Reddit OAuth (required edge-function secrets)
# Create a Reddit "script" app and configure both values in Supabase Edge Function Secrets.
# The discovery function intentionally does not fall back to anonymous Reddit requests.
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# MVP Builder mandatory integrations
# Configure these in Supabase Dashboard > Edge Functions > Secrets
INTEGRATION_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-chars
GITHUB_APP_CLIENT_ID=your-github-app-oauth-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-oauth-client-secret
SUPABASE_OAUTH_CLIENT_ID=your-supabase-oauth-client-id
SUPABASE_OAUTH_CLIENT_SECRET=your-supabase-oauth-client-secret

# Mapbox Configuration (optional - for location search)
# Get your token from: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your-mapbox-public-token

# Feature flags (set to "true" to enable)
VITE_ENABLE_MONTHLY_CREDITS_GRANT=false

# App version (injected at build time, e.g. "1.0.0")
VITE_APP_VERSION=0.0.0

# Stripe (server-side only — never expose to the browser)
# Configure these in Supabase Dashboard > Edge Functions > Secrets
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret

# PostHog (server-side edge function usage — VITE_ equivalents above are for the browser SDK)
VITE_POSTHOG_KEY=your-posthog-project-api-key
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Non-blocking AI tie-breaker. Deterministic recommendations remain the fallback.
VITE_DASHBOARD_AI_RANKING_ENABLED=false
VITE_MESSAGES_INBOX_V2_ENABLED=true
VITE_ONBOARDING_ACTIVATION_V2=false
# Evidence-driven PROVE -> SELL -> GROW beta. PostHog flag takes precedence.
VITE_FOUNDER_CYCLE_V1=false
VITE_FOUNDER_CYCLE_V1_ROLLOUT_PERCENT=0
# Global First Customer Sprint V1 override. Leave empty to use the PostHog
# first-customer-sprint-v1 switch, false for emergency-off, or true for local testing.
VITE_FIRST_CUSTOMER_SPRINT_V1=
# PMF pathway UX emergency kill switch. PostHog flag `pmf-pathway-v1`
# controls account rollout; set this to false to disable it for everyone.
VITE_PMF_PATHWAY_ENABLED=true

# Discovery Call Request Workflow V2 (Supabase Edge Function secrets)
# Keep disabled until mentor notification addresses and the Resend sender are verified.
DISCOVERY_CALL_REQUESTS_V2_ENABLED=false
# Google Meet attendance is shadow-mode safe until explicitly enabled. The
# organizer refresh token must be reauthorized with meetings.space.readonly.
DISCOVERY_CALL_ATTENDANCE_TRACKING_ENABLED=false
# Start false (shadow mode); enable only after comparing ten real calls with
# audited outcomes and finding no false completed calls.
DISCOVERY_CALL_ATTENDANCE_AUTO_COMPLETE_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_REFRESH_TOKEN=your-google-organizer-refresh-token
DISCOVERY_CALL_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-chars
RESEND_API_KEY=re_your-resend-key
FROM_EMAIL=noreply@updates.creatives-takeover.com
# Personal inactive-user notes use this address for replies.
RETENTION_REPLY_TO=javier@creatives-takeover.com
# Shared HMAC secret for lifecycle and retention unsubscribe links.
EMAIL_SEQUENCE_UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret-at-least-32-chars
APP_URL=https://creatives-takeover.com
CRON_SECRET=replace-with-a-long-random-cron-secret
