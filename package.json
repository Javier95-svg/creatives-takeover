{
  "name": "creatives-takeover",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/validate-build-env.mjs",
    "build": "node scripts/generate-llms-txt.mjs && node scripts/generate-seo-assets.mjs && vite build && node scripts/generate-prerendered-pages.mjs && node scripts/verify-seo-build.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "test:analytics": "node --experimental-strip-types --test tests/analytics-governance.test.ts tests/attribution.test.ts tests/dual-analytics-events.test.ts tests/server-analytics-events.test.ts",
    "test:mvp-builder": "node --experimental-strip-types --test tests/mvp-builder-project.test.ts",
    "test:waitlist": "node --experimental-strip-types --test tests/waitlist-model.test.ts",
    "typecheck": "tsc --noEmit",
    "images:optimize": "node scripts/optimize-images.mjs",
    "lint:fix": "eslint . --fix",
    "test:smoke": "playwright test",
    "seo:crawler-content": "node scripts/update-crawler-content.mjs",
    "test:messages:performance": "node scripts/check-messages-performance.mjs",
    "test:bundle:performance": "node scripts/check-initial-bundle.mjs",
    "release:verify-pilot": "node scripts/verify-pilot-release.mjs",
    "test:onboarding:db": "node --test --test-concurrency=1 tests/account-onboarding-database.test.mjs",
    "test:onboarding:ui": "node --test --test-concurrency=1 tests/onboarding-ui.test.mjs"
  },
