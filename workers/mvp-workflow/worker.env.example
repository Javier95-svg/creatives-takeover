# Store actual values on the trusted host in /etc/ct/mvp-worker.env (mode 600).
CT_TEST_QUEUE_URL=https://YOUR_CT_PROJECT.supabase.co/functions/v1/mvp-workflow-tests
CT_TEST_QUEUE_KEY=REPLACE_WITH_SHARED_WORKER_SECRET_AT_LEAST_32_CHARACTERS
TEST_SUPABASE_URL=https://YOUR_SEPARATE_TEST_PROJECT.supabase.co
TEST_SUPABASE_SERVICE_KEY=REPLACE_ON_HOST_ONLY
TEST_SUPABASE_ANON_KEY=REPLACE_ON_HOST_ONLY
CT_WORKER_CONCURRENCY=2
CT_WORKER_STATE=/var/lib/ct-mvp-worker
