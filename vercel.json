{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.creatives-takeover.com" }],
      "destination": "https://creatives-takeover.com/$1",
      "permanent": true
    },
    { "source": "/@:username", "destination": "/profile/:username?via=short", "permanent": false },
    { "source": "/%40:username", "destination": "/profile/:username?via=short", "permanent": false },
    { "source": "/community/co-founders/:path*", "destination": "/co-founder/:path*", "permanent": true },
    { "source": "/community/angels/:path*", "destination": "/investors/:path*", "permanent": true },
    { "source": "/community/co-founders", "destination": "/co-founder", "permanent": true },
    { "source": "/community/angels", "destination": "/investors", "permanent": true },
    { "source": "/community/:path*", "destination": "/mentorship", "permanent": true },
    { "source": "/community", "destination": "/mentorship", "permanent": true },
    { "source": "/explore", "destination": "/marketplace", "permanent": true },
    { "source": "/marketplace/growth-consulting-for-startups", "destination": "/marketplace/get-marketing", "permanent": true },
    { "source": "/waitlist/templates", "destination": "/demo-studio/classic/templates", "permanent": true },
    { "source": "/waitlist", "destination": "/demo-studio/classic", "permanent": true },
    { "source": "/waitlist-maker", "destination": "/demo-studio/classic", "permanent": true },
    { "source": "/gtm-strategist", "destination": "/go-to-market", "permanent": true },
    { "source": "/stories", "destination": "/newspaper", "permanent": true },
    { "source": "/(newspaper|stories)/canva-rejected-over-100-investors-became-40b-company-c92xe", "destination": "/newspaper/canva-rejected-by-100-investors-became-40b-company", "permanent": true },
    { "source": "/(newspaper|stories)/saas-pricing-is-dying-founders-who-see-it-coming-are-already", "destination": "/newspaper/saas-pricing-is-dying-founders-switching-models", "permanent": true },
    { "source": "/(newspaper|stories)/the-hidden-value-behind-google-2006-billion-dollar-bet", "destination": "/newspaper/google-youtube-acquisition-2006-hidden-value", "permanent": true },
    { "source": "/(newspaper|stories)/one-rule-change-nearly-broke-the-worlds-fastest-growing-app", "destination": "/newspaper/temu-de-minimis-rule-change", "permanent": true },
    { "source": "/(newspaper|stories)/everyone-built-data-centers-one-founder-bought-the-land", "destination": "/newspaper/ai-data-centers-in-the-ocean-founder-story", "permanent": true },
    { "source": "/(newspaper|stories)/he-built-an-18-billion-telehealth-company-with-only-two-employees", "destination": "/newspaper/he-built-a-1-8-billion-telehealth-company-with-two-employees", "permanent": true },
    { "source": "/(newspaper|stories)/what-whatsapp-did-5-engineers-meta-could-do-thousands", "destination": "/newspaper/how-whatsapp-scaled-with-a-tiny-engineering-team", "permanent": true },
    { "source": "/(newspaper|stories)/hundreds-startups-built-entire-infrastructure-free", "destination": "/newspaper/startups-built-on-free-cloud-credits", "permanent": true },
    { "source": "/(newspaper|stories)/twitter-accident-four-founders-could-agree-what-exactly", "destination": "/newspaper/twitter-was-an-accident-founders-could-not-agree", "permanent": true },
    { "source": "/(newspaper|stories)/founder-who-cannot-kill-own-idea-watch-market-do-them", "destination": "/newspaper/founders-who-cannot-kill-their-own-idea", "permanent": true },
    { "source": "/(newspaper|stories)/truth-accelerators-founders-only-learn-after-join-one", "destination": "/newspaper/truth-about-accelerators-founders-learn-after-joining", "permanent": true },
    { "source": "/(newspaper|stories)/how-to-test-your-icp-before-bet-go-to-market", "destination": "/newspaper/how-to-test-your-icp-before-go-to-market", "permanent": true },
    { "source": "/(newspaper|stories)/startup-government-tried-kill-what-founders-can-learn", "destination": "/newspaper/the-startup-the-government-tried-to-kill", "permanent": true },
    { "source": "/insighta/vc-search", "destination": "/vc-search", "permanent": true },
    { "source": "/insighta/email-templates", "destination": "/email-templates", "permanent": true },
    { "source": "/insighta/accelerator-hunt", "destination": "/accelerator-hunt", "permanent": true },
    { "source": "/insighta/pitch-deck-analyzer", "destination": "/pitch-deck-analyzer", "permanent": true },
    { "source": "/insighta/test", "destination": "/insighta-test", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "[^.]+\\.creatives-takeover\\.com" }],
      "destination": "/api/published-site?p=:path"
    },
    { "source": "/pricing", "destination": "/pricing/index.html" },
    { "source": "/pricing/", "destination": "/pricing/index.html" },
    { "source": "/resources", "destination": "/resources/index.html" },
    { "source": "/resources/", "destination": "/resources/index.html" },
    { "source": "/marketplace", "destination": "/api/public-entity?type=marketplace" },
    { "source": "/marketplace/", "destination": "/api/public-entity?type=marketplace" },
    { "source": "/marketplace/:slug", "destination": "/api/public-entity?type=service&slug=:slug" },
    { "source": "/mentorship/progress", "destination": "/app-shell.html" },
    { "source": "/mentorship/my-bookings", "destination": "/app-shell.html" },
    { "source": "/mentorship/:slug", "destination": "/api/public-entity?type=mentor&slug=:slug" },
    { "source": "/co-founder/listing/:slug", "destination": "/api/public-entity?type=cofounder&slug=:slug" },
    { "source": "/profile/:slug", "destination": "/api/public-entity?type=profile&slug=:slug" },
    { "source": "/p/:slug", "destination": "/api/public-entity?type=launch&slug=:slug" },
    { "source": "/launches", "destination": "/api/public-entity?type=launches" },
    { "source": "/launches/", "destination": "/api/public-entity?type=launches" },
    { "source": "/og/p/:slug", "destination": "/api/og-launch?slug=:slug" },
    { "source": "/og/profile/:username", "destination": "/api/og-profile?username=:username" },
    { "source": "/newspaper/:slug", "destination": "/api/newspaper-og?slug=:slug" },
    { "source": "/stories/:slug", "destination": "/api/newspaper-og?slug=:slug" },
    { "source": "/sitemap-articles.xml", "destination": "/api/sitemap-articles" },
    { "source": "/sitemap-entities.xml", "destination": "/api/sitemap-entities" },
    { "source": "/sitemap-published.xml", "destination": "/api/sitemap-published" },
    { "source": "/((?!assets/).*)", "destination": "/app-shell.html" }
  ],
  "headers": [
    {
      "source": "/og/p/:slug",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/og/profile/:username",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/og-icp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(favicon.*|apple-touch-icon.*|site.webmanifest|robots.txt|sitemap.xml|llms.txt|og-image.png|og-founders-compass-2026-07.png|og-founders-compass-2026-09.png|og-founder-id.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(auth|mvp-builder-showcase|lovable-uploads|resources|templates)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/mvp-builder",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    },
    {
      "source": "/mvp-builder/:path*",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://www.youtube.com https://cdn.tailwindcss.com https://us.i.posthog.com https://us-assets.i.posthog.com https://e.creatives-takeover.com https://*.webcontainer-api.io https://*.staticblitz.com; worker-src 'self' blob:; frame-src 'self' blob: https://www.youtube-nocookie.com https://www.youtube.com https://*.webcontainer-api.io https://*.staticblitz.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com; img-src 'self' https: data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.amplitude.com https://api2.amplitude.com https://us.i.posthog.com https://us-assets.i.posthog.com https://e.creatives-takeover.com https://api.mapbox.com https://events.mapbox.com https://*.webcontainer-api.io https://*.staticblitz.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()" }
      ]
    },
    {
      "source": "/embed/demo/:publicId*",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://www.youtube.com https://cdn.tailwindcss.com https://us.i.posthog.com https://us-assets.i.posthog.com https://e.creatives-takeover.com https://*.webcontainer-api.io https://*.staticblitz.com; worker-src 'self' blob:; frame-src 'self' blob: https://www.youtube-nocookie.com https://www.youtube.com https://*.webcontainer-api.io https://*.staticblitz.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com; img-src 'self' https: data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.amplitude.com https://api2.amplitude.com https://us.i.posthog.com https://us-assets.i.posthog.com https://e.creatives-takeover.com https://api.mapbox.com https://events.mapbox.com https://*.webcontainer-api.io https://*.staticblitz.com; frame-ancestors *; base-uri 'self'; form-action 'self'" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
